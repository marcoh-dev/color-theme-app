{
	"name": "color-theme-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -b",
		"check": "npm run lint && npm run format:check && npm run typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"sync": "git switch main && git pull && node scripts/install-if-changed.mjs",
		"sync:branch": "git fetch origin && git merge --no-commit origin/main && node scripts/install-if-changed.mjs"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"uid": "^2.0.2",
		"use-local-storage-state": "^19.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
